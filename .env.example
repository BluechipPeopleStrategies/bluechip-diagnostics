# Formspree endpoint for diagnostic email opt-ins (separate from contact form).
# Get this from formspree.io after creating a form labeled "BlueChip Diagnostics — Email Opt-ins".
# For local dev, copy this file to .env.local and replace the placeholder.
# For prod, set this in Vercel project settings.
VITE_FORMSPREE_DIAGNOSTICS_ENDPOINT=https://formspree.io/f/REPLACE_ME

# Cal.com booking URL for the free Clarity Call (post-diagnostic).
# Created manually in Cal.com — see Task 1 of the implementation plan.
VITE_CAL_BOOKING_URL=https://cal.com/REPLACE_ME/clarity-call-free

# ----------------------------------------------------------------------------
# SERVER-SIDE (Vercel serverless functions in /api). These are NOT prefixed
# with VITE_ and are never exposed to the browser. Set them in Vercel project
# settings (Production + Preview). If any are missing, the matching feature
# SILENTLY skips (the API still returns ok:true) — so a missing key here means
# leads complete the funnel but no email sends and no Notion row is written.
# ----------------------------------------------------------------------------

# Resend transactional email (result email + 24h nudge). resend.com -> API Keys.
RESEND_API_KEY=re_REPLACE_ME
# Verified sender. Must be on a domain you've verified in Resend (e.g.
# diagnostics@bluechippeoplestrategies.com). Until a domain is verified, Resend
# only delivers to your own account email.
BLUECHIP_FROM_EMAIL=diagnostics@REPLACE_ME
# Internal address that gets new-contact notifications (api/contact.js).
BLUECHIP_NOTIFY_EMAIL=you@REPLACE_ME

# Notion lead capture. Internal integration token from notion.so/my-integrations
# (the integration must be shared into BOTH databases below).
NOTION_API_KEY=ntn_REPLACE_ME
# "Diagnostic Submissions" database id (api/submit.js writes leads here).
NOTION_DATABASE_ID=REPLACE_ME
# Contact-form database id (api/contact.js).
NOTION_CONTACT_DATABASE_ID=REPLACE_ME

# Server-side copy of the Cal.com booking URL, used inside email templates
# (the VITE_ one above is for the browser; this one is for /api).
CAL_BOOKING_URL=https://cal.com/REPLACE_ME/clarity-call-free
# Shared secret to verify inbound Cal.com booking webhooks (api/cal-webhook.js).
CAL_WEBHOOK_SECRET=REPLACE_ME
