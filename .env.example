# Formspree endpoint for diagnostic email opt-ins (separate from contact form).
# Get this from formspree.io after creating a form labeled "BlueChip Diagnostics — Email Opt-ins".
# For local dev, copy this file to .env.local and replace the placeholder.
# For prod, set this in Vercel project settings.
VITE_FORMSPREE_DIAGNOSTICS_ENDPOINT=https://formspree.io/f/REPLACE_ME

# Cal.com booking URL for the free Clarity Call (post-diagnostic).
# Created manually in Cal.com — see Task 1 of the implementation plan.
# For local dev, copy this file to .env.local and replace the placeholder.
# For prod, set this in Vercel project settings.
VITE_CAL_BOOKING_URL=https://cal.com/REPLACE_ME/clarity-call-free
