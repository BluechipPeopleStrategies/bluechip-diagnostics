{
  "redirects": [
    {
      "source": "/ai-audit",
      "destination": "/ai-handoff-plan",
      "permanent": true
    },
    {
      "source": "/ai-check",
      "destination": "/ai-opportunity-check",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/lead-selftest",
      "schedule": "0 14 * * *"
    }
  ]
}
